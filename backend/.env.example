# ─── MongoDB ──────────────────────────────────────────────────────────────────
# URI del replica set de Atlas. DEBE incluir el nombre del replica set (srv://).
# readPreference se fuerza a secondaryPreferred en código; si lo omites aquí
# el servidor lo inyecta automáticamente al arrancar.
MONGO_URI=mongodb+srv://<usuario>:<password>@<cluster>.mongodb.net/

# Nombres de las bases de datos dentro del mismo clúster.
MONGO_DB_CHANNELS=channels
MONGO_DB_INTERACTIONS=interactions

# Pool de conexiones (ajustar según el número de workers de uvicorn).
MONGO_MAX_POOL_SIZE=20
MONGO_MIN_POOL_SIZE=2
MONGO_SERVER_SELECTION_TIMEOUT_MS=8000

# ─── Límites de la agregación ─────────────────────────────────────────────────
# Tiempo máximo que MongoDB permite que corra una agregación (milisegundos).
# Si se supera, devuelve HTTP 504. Aumentar solo si los rangos grandes son
# frecuentes y el clúster lo soporta.
AGGREGATION_MAX_TIME_MS=120000

# ─── Reglas de negocio ────────────────────────────────────────────────────────
MAX_RANGE_DAYS_CHANNEL=31
MAX_RANGE_DAYS_TENANT=31
DEFAULT_TIMEZONE=America/Bogota

# ─── Caché en memoria ─────────────────────────────────────────────────────────
# TTL en segundos. Con 300 s las recargas de pantalla no cuestan agregación.
# En despliegue con múltiples réplicas cada pod tiene su propia copia.
REPORT_CACHE_TTL_SECONDS=300
REPORT_CACHE_MAX_ENTRIES=128

# ─── Servidor ─────────────────────────────────────────────────────────────────
# Cloud Run inyecta PORT=8080 automáticamente. En local puedes omitir esta línea
# o cambiarla al puerto que prefieras.
PORT=8080

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Clave secreta para firmar los tokens. Genera una con:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-this-secret-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Lista JSON de orígenes permitidos. En producción reemplazar localhost por el
# dominio real del frontend. En local puede dejarse como está.
CORS_ORIGINS=["http://localhost:5173"]
# Ejemplo producción:
# CORS_ORIGINS=["https://analytics.hibot.us"]
